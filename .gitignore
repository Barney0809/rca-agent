*.py[cod]
*$py.class
.venv/
venv/
ENV/
*.egg-info/
dist/
build/
.uv/
uv.toml.bak

# ============================================================
#  工具缓存
# ============================================================
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ============================================================
#  运行产物（不进版本控制）
# ============================================================
# ⚠️ 写成 `runs/*` 而不是 `runs/`：**父目录整体被排除时，
#    git 不会进目录里再看 `!` 反选规则**，下面的证据就没法被包含进来。
runs/*
logs/
*.log
*.ndjson

# ------------------------------------------------------------
#  D12/D15 定稿数字的**证据**（AC-12：陌生人克隆要能自己核对与复现）
#
#  这些运行是 `docs/06-多Agent结果.md` 里每个数字的来源，
#  也是 `demo/rca-demo.html` 那句「本页由存档生成」的**前提** ——
#  存档不进仓库的话，陌生人克隆后生成器直接报「找不到存档」，
#  我写的「页面可逐字节重放」用例也只会 skip：那句话就只在我这台机器上成立。
#
#  ⚠️ 只放这几次运行 + 一份录制（合计 ~2 MB），其余运行产物依旧不进仓库。
#     这一条有回归用例守着：`test_frozen_evidence_is_present_and_not_ignored`。
# ------------------------------------------------------------
!runs/_eval/
runs/_eval/*
!runs/_eval/baseline-20260925-085629/
!runs/_eval/multi-20260925-112648/
!runs/_eval/multi-20260925-131953/
!runs/_recordings/
runs/_recordings/*
!runs/_recordings/record-deepseek-flash.ndjson

# 隔离区：策略执行点的"软删除"去向。运行时数据，绝不上库。
quarantine/

# 录制回放的原始缓存（可分享的样例另存 samples/ 并显式提交）
recordings/
!samples/

# ============================================================
#  被诊断系统（world）的运行数据
# ============================================================
world/**/data/
world/**/*.db
world/**/__pycache__/

# ============================================================
#  留出集：调试期物理隔离
#  ⚠️ 刻意不 ignore —— 它必须能被审阅，只是不参与调试。
