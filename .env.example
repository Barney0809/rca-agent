# ============================================================
#  复制本文件为 .env 后填入真实值。
#  .env 已被 .gitignore 忽略，绝不会进入版本控制。
#  本文件（.env.example）只放占位符，永远不含真实凭据。
# ============================================================

# --- 模型凭据 ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- 模型路由 ---
# 粗活（日志解析 / 摘要 / 工具选择）走便宜模型；根因推理与冲突裁决走强模型。
# 注意：合法模型名只有这两个。deepseek-chat / deepseek-reasoner 已于 2026-07-24 停服。
RCA_MODEL_CHEAP=deepseek-flash
RCA_MODEL_STRONG=deepseek-v4-pro

# --- 推理模式 ---
# ⚠️ DeepSeek 的 thinking 默认为开启；不显式关闭会持续产生推理 token 费用，
#    使成本曲线失真。除根因推理外一律关闭。
RCA_THINKING_ENABLED=false

# --- 预算护栏（Loop of Death 四层防御的后两层）---
RCA_MAX_STEPS=20
RCA_TOKEN_BUDGET=200000
RCA_MONEY_BUDGET_YUAN=5.0

# --- 留出集开关 ---
# ⚠️ 调试期必须保持 false。留出集一旦参与调试就失去意义。
#    只有最终评测时才置为 true。
RCA_ALLOW_HOLDOUT=false

# --- 隔离区（策略执行点：替代硬删除）---
# 删除操作不直接删文件，而是移入隔离区并设置 TTL，可还原。
RCA_QUARANTINE_DIR=./quarantine
RCA_QUARANTINE_TTL_HOURS=72

# --- 被诊断系统的 Redis（docker-compose 会读取本项做变量替换）---
# 默认使用【本机原生 Redis】，容器经 host.docker.internal 访问宿主机。
# 密码只写在这里和 .env，绝不写进 docker-compose.yml（那个文件是入库的）。
# 若不想设密码，留空即可。
W_REDIS_PASSWORD=
