# 统一换行符，避免跨平台协作时"整文件都被改动"的噪音。
# 规则：默认按文本处理并用 LF；Windows 脚本保留 CRLF。

* text=auto eol=lf

# 构建与脚本文件必须保持 LF —— CRLF 会让 make / sh 解析出问题
Makefile    text eol=lf
*.sh        text eol=lf

# PowerShell 在 Windows 上按 CRLF 更稳妥
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 二进制文件不要做任何转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.xlsx      binary
*.zip       binary
*.gz        binary
*.zst       binary

# 锁文件视为生成物，但必须入库（可复现的基石）
uv.lock     text eol=lf

# 事件流样例：按文本处理，便于审阅
*.ndjson    text eol=lf
